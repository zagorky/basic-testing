{
  "name": "basic-testing",
  "version": "1.0.0",
  "type": "module",
  "description": "Task for mastering unit-tests with Jest, Node.js and Typescript",
  "author": "AlreadyBored",
  "license": "MIT",
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
